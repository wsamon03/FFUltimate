# NFL Fantasy Football Database Configuration
# Copy this file to .env and update with your database credentials

DB_HOST=localhost
DB_NAME=nfl_fantasy
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# ---------------------------------------------------------------------------
# user_api — OAuth & JWT configuration (required to run user_api service)
# ---------------------------------------------------------------------------

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/callback?provider=google

# Microsoft (Azure AD) OAuth 2.0
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:8001/auth/callback?provider=microsoft

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# State signing — separate secret for OAuth CSRF state parameter
STATE_SECRET_KEY=
